# AsciiEQ Discord Caption Bot - configuration
# Copy this file to ".env" and fill in your bot token.
# (setup.cmd creates .env for you automatically.)

# REQUIRED. Your bot token from https://discord.com/developers/applications
#   Developer Portal -> your app -> Bot -> Reset Token -> Copy.
#   Keep this secret - anyone with it can control your bot.
DISCORD_BOT_TOKEN=your_token_here

# The AsciiEQ API used to verify your paid license. Leave as-is.
ASCIIEQ_API_URL=https://api.asciieq.com

# Optional. Set to 1 for detailed per-speaker audio logs when troubleshooting.
# VERBOSE=1
